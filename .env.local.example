# ============================================================
# Stolen.Vote — Environment Variables Template
# Rename this file to .env.local for local development
# Add all of these to Vercel: Settings → Environment Variables
# DO NOT commit .env.local to the repo
# ============================================================

# Supabase (safe to expose to browser — use NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key_here

# Supabase service role — SERVER SIDE ONLY. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here

# Cloudflare R2 (add after R2 bucket is created)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=stolen-vote-images
R2_PUBLIC_URL=https://pub-XXXX.r2.dev

# Beehiiv (already in Vercel)
BEEHIIV_API_KEY=your_beehiiv_api_key
